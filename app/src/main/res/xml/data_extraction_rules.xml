<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for API 31+.
  Excludes all local auth/credential data from cloud backup and device transfer:
  the Room database (user_profiles table holds password hashes) and the encrypted
  secure prefs file that holds API keys.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="forex_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="forex_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
