<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (API 31+): keep the Room database and secure
  SharedPreferences out of both cloud backups and device-to-device transfers.
  See REVIEW.md F-09.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="forex_analyzer_db" />
        <exclude domain="database" path="forex_analyzer_db-shm" />
        <exclude domain="database" path="forex_analyzer_db-wal" />
        <exclude domain="sharedpref" path="forex_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="forex_analyzer_db" />
        <exclude domain="database" path="forex_analyzer_db-shm" />
        <exclude domain="database" path="forex_analyzer_db-wal" />
        <exclude domain="sharedpref" path="forex_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
