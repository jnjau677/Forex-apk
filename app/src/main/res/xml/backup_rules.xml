<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (API < 31 uses fullBackupContent).
  The Room database (trading data) and secure SharedPreferences must not leave
  the device via cloud backup. See REVIEW.md F-09.
-->
<full-backup-content>
    <exclude domain="database" path="forex_analyzer_db" />
    <exclude domain="database" path="forex_analyzer_db-shm" />
    <exclude domain="database" path="forex_analyzer_db-wal" />
    <exclude domain="sharedpref" path="forex_secure_prefs.xml" />
</full-backup-content>
