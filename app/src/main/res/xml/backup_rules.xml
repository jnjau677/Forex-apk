<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for devices older than API 31 (auto backup).
  Excludes all local auth/credential data: the Room database (user_profiles table holds
  password hashes) and the encrypted secure prefs file that holds API keys.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="forex_secure_prefs.xml" />
</full-backup-content>
